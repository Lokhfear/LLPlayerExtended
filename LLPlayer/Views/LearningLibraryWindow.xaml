<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:LLPlayer.ViewModels"
        xmlns:converters="clr-namespace:LLPlayer.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LearningLibraryViewModel}"
        Title="📖 Learning Library"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}">
    
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:NullToVisibilityConverter x:Key="NullToCollapsedConv" NullValue="Collapsed"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibleConv" NullValue="Visible"/>
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConv"/>
            <converters:StatusToBackgroundConverter x:Key="StatusToBg"/>
            <converters:BoolToStarIconConverter x:Key="StarIcon"/>
            <converters:ItemTypeLabelConverter x:Key="TypeLabel"/>
            
            <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header + Import/Export -->
            <RowDefinition Height="Auto"/>   <!-- Tabs: All / Favorites / Archive -->
            <RowDefinition Height="Auto"/>   <!-- Filters -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="📖 Learning Library" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding ImportCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        ToolTip="Import from JSON">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Width="18" Height="18" Margin="0,0,6,0"/>
                        <Run Text="Import"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="Export to JSON">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="18" Height="18" Margin="0,0,6,0"/>
                        <Run Text="Export"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Tabs: All / Favorites / Archive ─────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <ToggleButton Style="{StaticResource FilterChip}"
                          IsChecked="{Binding ShowArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                          Content="📚 All"
                          IsEnabled="{Binding ShowArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
            <ToggleButton Style="{StaticResource FilterChip}"
                          IsChecked="{Binding FavoritesOnly}"
                          Content="⭐ Favorites"/>
            <ToggleButton Style="{StaticResource FilterChip}"
                          IsChecked="{Binding ShowArchived}"
                          Content="🗄 Archive"/>
        </StackPanel>

        <!-- ── Filters ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Search -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="🔍 Search..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     VerticalAlignment="Center"/>
            
            <!-- Type filter -->
            <ComboBox Grid.Column="1"
                      SelectedItem="{Binding FilterType}"
                      Margin="8,0,0,0"
                      Width="100"
                      materialDesign:HintAssist.Hint="Type"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      VerticalAlignment="Center">
                <ComboBox.ItemsSource>
                    <x:Array Type="{x:Type sys:Nullable}">
                        <sys:Nullable x:Type="vm:ItemType">Word</sys:Nullable>
                        <sys:Nullable x:Type="vm:ItemType">Phrase</sys:Nullable>
                        <sys:Nullable x:Type="vm:ItemType">Sentence</sys:Nullable>
                    </x:Array>
                </ComboBox.ItemsSource>
            </ComboBox>
            
            <!-- Status filter -->
            <ComboBox Grid.Column="2"
                      SelectedItem="{Binding FilterStatus}"
                      Margin="8,0,0,0"
                      Width="120"
                      materialDesign:HintAssist.Hint="Status"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      VerticalAlignment="Center"/>
            
            <!-- Has Media -->
            <CheckBox Grid.Column="3"
                      Content="🎬 Has Media"
                      IsChecked="{Binding HasMediaOnly}"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"/>
            
            <!-- Sort -->
            <ComboBox Grid.Column="4"
                      SelectedItem="{Binding SortMode}"
                      Margin="8,0,0,0"
                      Width="150"
                      materialDesign:HintAssist.Hint="Sort by"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Newest"/>
                <ComboBoxItem Content="Oldest"/>
                <ComboBoxItem Content="Alphabetical"/>
                <ComboBoxItem Content="Recently Reviewed"/>
                <ComboBoxItem Content="Most Reviewed"/>
            </ComboBox>
        </Grid>

        <!-- ── Content ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="3">
            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Top"
                         Height="3"/>
            
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="BookOpenPageVariant" 
                                         Width="64" Height="64" 
                                         Opacity="0.3"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="No items found" 
                           FontSize="18" 
                           Margin="0,16,0,8"
                           HorizontalAlignment="Center"
                           Opacity="0.6"/>
                <TextBlock Text="Right-click a word in subtitles → Add to Dictionary" 
                           FontSize="12" 
                           HorizontalAlignment="Center"
                           Opacity="0.4"/>
            </StackPanel>
            
            <!-- Items list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,8" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Type badge -->
                                    <Border Grid.Column="0"
                                            Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                            Width="40" Height="40"
                                            CornerRadius="4"
                                            Margin="12">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                    
                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" Margin="0,12,12,12">
                                        <!-- Text + Translation -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text=" — "
                                                       FontSize="16"
                                                       Opacity="0.5"
                                                       Visibility="{Binding Translation, Converter={StaticResource NullToCollapsedConv}}"/>
                                            <TextBlock Text="{Binding Translation}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       Visibility="{Binding Translation, Converter={StaticResource NullToCollapsedConv}}"/>
                                        </StackPanel>
                                        
                                        <!-- Context sentence -->
                                        <TextBlock Text="{Binding ContextSentence}"
                                                   FontStyle="Italic"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding ContextSentence, Converter={StaticResource NullToCollapsedConv}}"/>
                                        
                                        <!-- Media info -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding Media, Converter={StaticResource NullToCollapsedConv}}">
                                            <materialDesign:PackIcon Kind="Filmstrip" Width="14" Height="14" Opacity="0.5"/>
                                            <TextBlock Text="{Binding Media.VideoTitle}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding Media.TimestampDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8">
                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Toggle Favorite">
                                            <materialDesign:PackIcon Kind="{Binding IsFavorite, Converter={StaticResource StarIcon}}" Width="20" Height="20"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Archive"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                            <materialDesign:PackIcon Kind="Archive" Width="20" Height="20"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Restore"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="Restore" Width="20" Height="20"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Open Video"
                                                Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="Play" Width="20" Height="20"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Delete">
                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── Status Bar ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       Opacity="0.6"
                       FontSize="12"
                       VerticalAlignment="Center">
                <Run Text="{Binding ShownCount, Mode=OneWay}"/>
                <Run Text="shown /"/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text="total"/>
            </TextBlock>
            
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       Opacity="0.8"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConv}}"/>
        </Grid>
    </Grid>
</Window>
