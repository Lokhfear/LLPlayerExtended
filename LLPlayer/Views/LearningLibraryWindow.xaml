<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:LLPlayer.ViewModels"
        xmlns:converters="clr-namespace:LLPlayer.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LearningLibraryViewModel}"
        Title="Learning Library"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}">
    
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:StatusToColorConverter x:Key="StatusToColor"/>
            <converters:BoolToStarIconConverter x:Key="BoolToStar"/>
            <converters:ItemTypeLabelConverter x:Key="ItemTypeLabel"/>
            <converters:TimestampToDateConverter x:Key="TimestampToDate"/>
            <converters:SecondsToTimeSpanConverter x:Key="SecondsToTime"/>
            
            <Style x:Key="FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Width" Value="140"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header + Search -->
            <RowDefinition Height="Auto"/>   <!-- Filters -->
            <RowDefinition Height="Auto"/>   <!-- Stats -->
            <RowDefinition Height="*"/>      <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Header: Title + Search + Import/Export ─────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search words, phrases, translations, tags..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding ClearFiltersCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <!-- Import/Export Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding ImportCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="Import from JSON"
                        Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Margin="0,0,8,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding ExportCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="Export to JSON"
                        Margin="4,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Margin="0,0,8,0"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Filter Panel ────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" 
                Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <WrapPanel>
                <!-- Type Filter -->
                <ComboBox Style="{StaticResource FilterComboBox}"
                          SelectedItem="{Binding FilterType, Mode=TwoWay}"
                          DisplayMemberPath="."
                          materialDesign:HintAssist.Hint="Type">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type sys:Object}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <vm:ItemType>Word</vm:ItemType>
                            <vm:ItemType>Phrase</vm:ItemType>
                            <vm:ItemType>Sentence</vm:ItemType>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Status Filter -->
                <ComboBox Style="{StaticResource FilterComboBox}"
                          SelectedItem="{Binding FilterStatus, Mode=TwoWay}"
                          DisplayMemberPath="."
                          materialDesign:HintAssist.Hint="Status">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type sys:Object}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <vm:LearningStatus>New</vm:LearningStatus>
                            <vm:LearningStatus>Learning</vm:LearningStatus>
                            <vm:LearningStatus>Learned</vm:LearningStatus>
                            <vm:LearningStatus>Ignored</vm:LearningStatus>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Sort Mode -->
                <ComboBox Style="{StaticResource FilterComboBox}"
                          SelectedItem="{Binding SortMode, Mode=TwoWay}"
                          DisplayMemberPath="."
                          materialDesign:HintAssist.Hint="Sort By">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type sys:Object}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <vm:SortMode>Newest</vm:SortMode>
                            <vm:SortMode>Oldest</vm:SortMode>
                            <vm:SortMode>Alphabetical</vm:SortMode>
                            <vm:SortMode>RecentlyReviewed</vm:SortMode>
                            <vm:SortMode>MostReviewed</vm:SortMode>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Checkboxes -->
                <CheckBox Content="Favorites Only"
                          IsChecked="{Binding FavoritesOnly}"
                          Margin="8,0"
                          VerticalAlignment="Center"/>
                
                <CheckBox Content="Has Media"
                          IsChecked="{Binding HasMediaOnly}"
                          Margin="8,0"
                          VerticalAlignment="Center"/>
                
                <CheckBox Content="Show Archived"
                          IsChecked="{Binding ShowArchived}"
                          Margin="8,0"
                          VerticalAlignment="Center"/>

                <!-- Clear Filters Button -->
                <Button Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource MaterialDesignTextButton}"
                        ToolTip="Clear all filters"
                        Margin="8,0">
                    <materialDesign:PackIcon Kind="FilterRemove"/>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ── Statistics Bar ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Opacity="0.7">
                <Run FontWeight="SemiBold" Text="{Binding ShownCount, Mode=OneWay}"/>
                <Run Text="of"/>
                <Run FontWeight="SemiBold" Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text="items shown"/>
            </TextBlock>

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage, Mode=OneWay}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ── Main Content Area ───────────────────────────────────────────────── -->
        <Grid Grid.Row="3">
            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Top"
                         Height="3"/>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        Margin="32">
                <materialDesign:PackIcon Kind="Bookshelf" 
                                         Width="64" Height="64"
                                         Opacity="0.3"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="No learning items yet"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8"
                           Opacity="0.7"/>
                <TextBlock Text="Right-click on a word in subtitles and select &quot;Add to Dictionary&quot;"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.5"
                           MaxWidth="400"/>
            </StackPanel>

            <!-- Items List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,8" Padding="0">
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>  <!-- Type badge -->
                                        <ColumnDefinition Width="*"/>     <!-- Content -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Type Badge -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Grid.RowSpan="4"
                                            Background="{Binding Status, Converter={StaticResource StatusToColor}}"
                                            CornerRadius="4"
                                            Width="32" Height="32"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Main Text + Translation -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" — "
                                                   FontSize="16"
                                                   Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Translation, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Translation}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Translation, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <!-- Context Sentence -->
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding ContextSentence}"
                                               FontStyle="Italic"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding ContextSentence, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Media Info + Tags -->
                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                                        <!-- Media indicator -->
                                        <Border Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
                                                CornerRadius="4" Padding="6,2"
                                                Margin="0,0,4,0"
                                                Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Video" Width="14" Height="14"
                                                                         VerticalAlignment="Center"
                                                                         Opacity="0.7"/>
                                                <TextBlock Text="{Binding Media.VideoTitle}"
                                                           FontSize="11"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"
                                                           MaxLength="30"/>
                                                <TextBlock Text="{Binding Media.TimestampSeconds, Converter={StaticResource SecondsToTime}}"
                                                           FontSize="10"
                                                           Opacity="0.5"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tags -->
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SecondaryHueMidBrush}"
                                                            CornerRadius="8" Padding="6,2"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="10"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <!-- Metadata (created date, review count) -->
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               FontSize="10"
                                               Opacity="0.5"
                                               Margin="0,4,0,0">
                                        <Run Text="Added:"/>
                                        <Run Text="{Binding CreatedAt, Converter={StaticResource TimestampToDate}}"/>
                                        <Run Text="·"/>
                                        <Run Text="Reviews:"/>
                                        <Run Text="{Binding ReviewCount}"/>
                                    </TextBlock>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="0" Grid.Column="2"
                                                Grid.RowSpan="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <!-- Favorite Toggle -->
                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="{Binding IsFavorite, Converter={StaticResource BoolToStar}, ConverterParameter='Toggle Favorite'}">
                                            <materialDesign:PackIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToStar}}"
                                                                     Width="18" Height="18"/>
                                        </Button>

                                        <!-- Open Video (if has media) -->
                                        <Button Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Open video at timestamp"
                                                Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18"/>
                                        </Button>

                                        <!-- Archive/Restore -->
                                        <Button Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Archive"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                            <materialDesign:PackIcon Kind="Archive" Width="18" Height="18"/>
                                        </Button>
                                        
                                        <Button Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Restore from archive"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="ArchiveArrowUp" Width="18" Height="18"/>
                                        </Button>

                                        <!-- Delete -->
                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="Delete">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
