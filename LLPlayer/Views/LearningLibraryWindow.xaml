
<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:LLPlayer.Models"
        xmlns:services="clr-namespace:LLPlayer.Services"
        Title="Learning Library"
        Width="980"
        Height="720"
        MinWidth="700"
        MinHeight="500"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource LLE.Brush.Background.Primary}"
            BorderBrush="{DynamicResource LLE.Brush.Border.Medium}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border Grid.Row="0"
                    Padding="18,14"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Light}"
                    BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Learning Library"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                        <TextBlock Text="Saved words, translations and subtitle context"
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                   Opacity="0.85"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Command="{Binding ImportCommand}"
                                Margin="0,0,8,0"
                                Padding="14,7"
                                Style="{StaticResource MaterialDesignFlatButton}">

                            <StackPanel Orientation="Horizontal">

                                <md:PackIcon Kind="Import"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,6,0"
                                             Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                                <TextBlock Text="Import"
                                           Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                            </StackPanel>

                        </Button>

                        <Button Command="{Binding ExportCommand}"
                                Padding="14,7"
                                Style="{StaticResource MaterialDesignFlatButton}">

                            <StackPanel Orientation="Horizontal">

                                <md:PackIcon Kind="Export"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,6,0"
                                             Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                                <TextBlock Text="Export"
                                           Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- FILTERS -->

            <Border Grid.Row="1"
                    Padding="16,12"
                    Background="{DynamicResource LLE.Brush.Background.Tertiary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Light}"
                    BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH -->

                    <TextBox Grid.Column="0"
                             Margin="0,0,10,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             md:HintAssist.Hint="Search word, translation, sentence or video..."
                             md:TextFieldAssist.HasClearButton="True"
                             FontSize="14"
                             Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                    <!-- STATUS -->

                    <ComboBox Grid.Column="1"
                              Margin="0,0,10,0"
                              SelectedValue="{Binding FilterStatus}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource LLE.FilterComboBox}"
                              md:HintAssist.Hint="Status">

                        <ComboBoxItem Content="All"
                                      Tag="{x:Null}"/>

                        <ComboBoxItem Content="New"
                                      Tag="{x:Static models:LearningStatus.New}"/>

                        <ComboBoxItem Content="Learning"
                                      Tag="{x:Static models:LearningStatus.Learning}"/>

                        <ComboBoxItem Content="Learned"
                                      Tag="{x:Static models:LearningStatus.Learned}"/>

                        <ComboBoxItem Content="Ignored"
                                      Tag="{x:Static models:LearningStatus.Ignored}"/>

                    </ComboBox>

                    <!-- SORT -->

                    <ComboBox Grid.Column="2"
                              SelectedValue="{Binding SortMode}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource LLE.FilterComboBox}"
                              md:HintAssist.Hint="Sort">

                        <ComboBoxItem Content="Newest"
                                      Tag="{x:Static services:SortMode.Newest}"/>

                        <ComboBoxItem Content="Oldest"
                                      Tag="{x:Static services:SortMode.Oldest}"/>

                        <ComboBoxItem Content="A → Z"
                                      Tag="{x:Static services:SortMode.Alphabetical}"/>

                        <ComboBoxItem Content="Recently reviewed"
                                      Tag="{x:Static services:SortMode.RecentlyReviewed}"/>

                    </ComboBox>

                    <!-- ACTIONS -->

                    <StackPanel Grid.Column="3"
                                Margin="14,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <ToggleButton IsChecked="{Binding FavoritesOnly}"
                                      Margin="0,0,6,0"
                                      Width="34"
                                      Height="34"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ToolTip="Favorites only">

                            <md:PackIcon Kind="StarOutline"
                                         Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                        </ToggleButton>

                        <ToggleButton IsChecked="{Binding ShowArchived}"
                                      Margin="0,0,6,0"
                                      Width="34"
                                      Height="34"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ToolTip="Archived">

                            <md:PackIcon Kind="ArchiveOutline"
                                         Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                        </ToggleButton>

                        <Button Command="{Binding ExpandAllCommand}"
                                Width="34"
                                Height="34"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Expand all">

                            <md:PackIcon Kind="ArrowExpandVertical"
                                         Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                        </Button>

                        <Button Command="{Binding CollapseAllCommand}"
                                Width="34"
                                Height="34"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Collapse all">

                            <md:PackIcon Kind="ArrowCollapseVertical"
                                         Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                        </Button>

                        <Button Command="{Binding ClearFiltersCommand}"
                                Width="34"
                                Height="34"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Clear filters">

                            <md:PackIcon Kind="FilterRemoveOutline"
                                         Width="18"
                                         Height="18"
                                         Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- CONTENT -->

            <Grid Grid.Row="2">

                <!-- LOADING -->

                <ProgressBar IsIndeterminate="True"
                             Height="2"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsLoading,
                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- EMPTY -->

                <Grid Visibility="{Binding IsEmpty,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="📚"
                                   FontSize="48"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Your library is empty"
                                   Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                        <TextBlock Text="Add words from subtitles to start learning"
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                    </StackPanel>

                </Grid>

                <!-- LIST -->

                <ListBox ItemsSource="{Binding Items}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding IsEmpty,
                            Converter={StaticResource InverseBoolToVisConverter}}"
                         Margin="10">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding"
                                    Value="0"/>

                            <Setter Property="Margin"
                                    Value="0"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                            <Setter Property="Background"
                                    Value="Transparent"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="Focusable"
                                    Value="False"/>

                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    CornerRadius="10"
                                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                                    BorderBrush="{DynamicResource LLE.Brush.Border.Light}"
                                    BorderThickness="1">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- HEADER -->

                                    <Grid Grid.Row="0"
                                          Margin="16,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- TEXT -->

                                        <StackPanel Grid.Column="0">

                                            <WrapPanel>

                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                                                <TextBlock Text="  —  "
                                                           Margin="8,0"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Hint}"
                                                           Visibility="{Binding Translation,
                                                               Converter={StaticResource NullToCollapsedConv}}"/>

                                                <TextBlock Text="{Binding Translation}"
                                                           FontSize="19"
                                                           Foreground="{DynamicResource LLE.Brush.Accent.Blue}"
                                                           Opacity="0.9"
                                                           Visibility="{Binding Translation,
                                                               Converter={StaticResource NullToCollapsedConv}}"/>

                                            </WrapPanel>

                                            <TextBlock Text="{Binding ContextSentence}"
                                                       Margin="0,10,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       LineHeight="22"
                                                       Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                                       Opacity="0.88"/>

                                        </StackPanel>

                                        <!-- BUTTONS -->

                                        <Grid Grid.Column="1"
                                              Margin="12,0,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- FAVORITE -->

                                            <Button Grid.Column="0"
                                                    Width="32"
                                                    Height="32"
                                                    Margin="2"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">

                                                <md:PackIcon Kind="{Binding IsFavorite,
                                                    Converter={StaticResource BoolToStarIconConverter}}"
                                                             Width="17"
                                                             Height="17"
                                                             Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                                            </Button>

                                            <!-- ARCHIVE -->

                                            <Button Grid.Column="1"
                                                    Width="32"
                                                    Height="32"
                                                    Margin="2"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Visibility="{Binding IsArchived,
                                                        Converter={StaticResource InverseBoolToVisConverter}}"
                                                    Command="{Binding DataContext.ArchiveCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">

                                                <md:PackIcon Kind="ArchiveOutline"
                                                             Width="17"
                                                             Height="17"
                                                             Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                                            </Button>

                                            <!-- RESTORE -->

                                            <Button Grid.Column="2"
                                                    Width="32"
                                                    Height="32"
                                                    Margin="2"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Visibility="{Binding IsArchived,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RestoreCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">

                                                <md:PackIcon Kind="Restore"
                                                             Width="17"
                                                             Height="17"
                                                             Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                                            </Button>

                                            <!-- DELETE -->

                                            <Button Grid.Column="3"
                                                    Width="32"
                                                    Height="32"
                                                    Margin="2"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">

                                                <md:PackIcon Kind="DeleteOutline"
                                                             Width="17"
                                                             Height="17"
                                                             Foreground="{DynamicResource LLE.Brush.Text.Secondary}"/>

                                            </Button>

                                            <!-- EXPAND -->

<ToggleButton Grid.Column="4"
              Width="32"
              Height="32"
              Margin="2"
              Background="Transparent"
              BorderThickness="0"
              IsChecked="{Binding IsExpanded, Mode=TwoWay}">

    <Grid>

        <md:PackIcon Kind="ChevronDown"
                     Width="18"
                     Height="18"
                     Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                     Visibility="{Binding IsExpanded,
                        Converter={StaticResource InverseBoolToVisConverter}}"/>

        <md:PackIcon Kind="ChevronUp"
                     Width="18"
                     Height="18"
                     Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                     Visibility="{Binding IsExpanded,
                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

    </Grid>

</ToggleButton>



                                        </Grid>

                                    </Grid>

                                    <!-- EXPANDED -->

                                    <Border Grid.Row="1"
                                            Padding="16,14"
                                            Background="{DynamicResource LLE.Brush.Background.Tertiary}"
                                            BorderBrush="{DynamicResource LLE.Brush.Border.Light}"
                                            BorderThickness="0,1,0,0"
                                            Visibility="{Binding IsExpanded,
                                                Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <StackPanel>

                                            <TextBlock Text="{Binding ContextSentence}"
                                                       TextWrapping="Wrap"
                                                       FontSize="15"
                                                       LineHeight="24"
                                                       Foreground="{DynamicResource LLE.Brush.Text.Primary}"
                                                       Opacity="0.96"/>

                                            <TextBlock Text="{Binding ContextSentenceTranslation}"
                                                       Margin="0,10,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       LineHeight="22"
                                                       Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                                       Visibility="{Binding ContextSentenceTranslation,
                                                           Converter={StaticResource NullToCollapsedConv}}"/>

                                            <!-- VIDEO -->

                                            <Button Margin="0,14,0,0"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                                                    BorderBrush="{DynamicResource LLE.Brush.Border.Light}"
                                                    BorderThickness="1"
                                                    Visibility="{Binding Media.HasMedia,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.OpenVideoCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">

                                                <StackPanel Orientation="Horizontal">

                                                    <md:PackIcon Kind="PlayCircleOutline"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,8,0"
                                                                 Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>

                                                    <TextBlock FontSize="13"
                                                               Foreground="{DynamicResource LLE.Brush.Text.Primary}">

                                                        <Run Text="{Binding Media.VideoTitle}"/>
                                                        <Run Text=" "/>
                                                       <Run Text="{Binding Media.TimestampDisplay, Mode=OneWay}"/>
                                                    </TextBlock>

                                                </StackPanel>

                                            </Button>

                                        </StackPanel>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

            <!-- STATUS -->

            <Border Grid.Row="3"
                    Padding="12,8"
                    Background="{DynamicResource LLE.Brush.Background.Quaternary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Light}"
                    BorderThickness="0,1,0,0">

                <Grid>

                    <TextBlock HorizontalAlignment="Left"
                               FontSize="12"
                               Foreground="{DynamicResource LLE.Brush.Text.Hint}">

                        <Run Text="{Binding ShownCount}"/>
                        <Run Text=" shown / "/>
                        <Run Text="{Binding TotalCount}"/>
                        <Run Text=" total"/>

                    </TextBlock>

                    <TextBlock Text="{Binding StatusMessage}"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource LLE.Brush.Accent.Blue}"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
