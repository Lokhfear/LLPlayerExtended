<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:LLPlayer.Models"
        xmlns:services="clr-namespace:LLPlayer.Services"
        Title="Learning Library"
        Width="900" Height="620"
        MinWidth="600" MinHeight="450"
        Background="{DynamicResource MaterialDesignPaper}"
        Style="{StaticResource MaterialDesignWindow}"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Цвета статусов -->
        <SolidColorBrush x:Key="StatusNew"      Color="#2196F3"/>
        <SolidColorBrush x:Key="StatusLearning" Color="#FF9800"/>
        <SolidColorBrush x:Key="StatusLearned"  Color="#4CAF50"/>
        <SolidColorBrush x:Key="StatusIgnored"  Color="#9E9E9E"/>
        <SolidColorBrush x:Key="StatusArchived" Color="#795548"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Tab bar -->
            <RowDefinition Height="Auto"/>  <!-- Filter bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueDarkBrush}"
              Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="📖 Learning Library"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="16,10"/>

            <Button Grid.Column="1"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    Foreground="White"
                    Content="Import"
                    Margin="0,4,4,4"/>

            <Button Grid.Column="2"
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource MaterialDesignFlatLightButton}"
                    Foreground="White"
                    Content="Export"
                    Margin="0,4,8,4"/>
        </Grid>

        <!-- ══ ВКЛАДКИ ════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Background="{DynamicResource MaterialDesignToolBarBackground}"
                    Margin="0,0,0,1">

            <RadioButton Content="All"
                         IsChecked="True"
                         Style="{StaticResource MaterialDesignTabRadioButton}"
                         Command="{Binding ClearFiltersCommand}"
                         Margin="4,0"/>

            <RadioButton Content="⭐ Favorites"
                         Style="{StaticResource MaterialDesignTabRadioButton}"
                         Margin="4,0">
                <RadioButton.Command>
                    <Binding Path="FavoritesOnlyCommand"/>
                </RadioButton.Command>
            </RadioButton>

            <RadioButton Content="🗄 Archive"
                         Style="{StaticResource MaterialDesignTabRadioButton}"
                         Margin="4,0">
                <RadioButton.IsChecked>
                    <Binding Path="ShowArchived"/>
                </RadioButton.IsChecked>
            </RadioButton>
        </StackPanel>

        <!-- ══ FILTER BAR ════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="🔍  Search text, translation, tags, video..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     md:TextFieldAssist.HasClearButton="True"
                     Margin="0,0,8,0"/>

            <!-- Тип -->
            <ComboBox Grid.Column="1"
                      SelectedValue="{Binding FilterType}"
                      SelectedValuePath="Tag"
                      md:HintAssist.Hint="Type"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="All types" Tag="{x:Null}"/>
                <ComboBoxItem Content="Word"     Tag="{x:Static models:ItemType.Word}"/>
                <ComboBoxItem Content="Phrase"   Tag="{x:Static models:ItemType.Phrase}"/>
                <ComboBoxItem Content="Sentence" Tag="{x:Static models:ItemType.Sentence}"/>
            </ComboBox>

            <!-- Статус -->
            <ComboBox Grid.Column="2"
                      SelectedValue="{Binding FilterStatus}"
                      SelectedValuePath="Tag"
                      md:HintAssist.Hint="Status"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="All statuses" Tag="{x:Null}"/>
                <ComboBoxItem Content="New"      Tag="{x:Static models:LearningStatus.New}"/>
                <ComboBoxItem Content="Learning" Tag="{x:Static models:LearningStatus.Learning}"/>
                <ComboBoxItem Content="Learned"  Tag="{x:Static models:LearningStatus.Learned}"/>
                <ComboBoxItem Content="Ignored"  Tag="{x:Static models:LearningStatus.Ignored}"/>
            </ComboBox>

            <!-- Сортировка -->
            <ComboBox Grid.Column="3"
                      SelectedValue="{Binding SortMode}"
                      SelectedValuePath="Tag"
                      md:HintAssist.Hint="Sort"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="Newest"    Tag="{x:Static services:SortMode.Newest}"/>
                <ComboBoxItem Content="Oldest"    Tag="{x:Static services:SortMode.Oldest}"/>
                <ComboBoxItem Content="A → Z"     Tag="{x:Static services:SortMode.Alphabetical}"/>
                <ComboBoxItem Content="Reviewed"  Tag="{x:Static services:SortMode.RecentlyReviewed}"/>
            </ComboBox>

            <!-- Сбросить -->
            <Button Grid.Column="4"
                    Command="{Binding ClearFiltersCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Clear all filters"
                    VerticalAlignment="Center">
                <md:PackIcon Kind="FilterRemove" Width="20" Height="20" Opacity="0.6"/>
            </Button>
        </Grid>

        <!-- ══ СПИСОК ════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- Загрузка -->
            <ProgressBar IsIndeterminate="True"
                         VerticalAlignment="Top"
                         Height="2"
                         Visibility="{Binding IsLoading,
                             Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- ПУСТОЙ ЭКРАН -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="📭" FontSize="48"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Nothing here yet"
                           FontSize="18" FontWeight="Medium"
                           HorizontalAlignment="Center" Opacity="0.7"/>
                <TextBlock Text="Right-click a word in subtitles → Add to Dictionary"
                           FontSize="13" Opacity="0.5"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- СПИСОК КАРТОЧЕК — VirtualizingStackPanel для производительности -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty,
                              Converter={StaticResource InverseBoolToVisConverter}}">
                <ItemsControl ItemsSource="{Binding Items}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Margin="12,4,12,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ── КАРТОЧКА ────────────────────────── -->
                            <md:Card Margin="0,0,0,6" Padding="0">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>  <!-- тип-значок -->
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>  <!-- кнопки -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Тип + статус -->
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="4"
                                            Background="{DynamicResource PrimaryHueLightBrush}"
                                            VerticalAlignment="Top"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                                    </Border>

                                    <!-- Контент -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">

                                        <!-- Слово + перевод -->
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text=" — "
                                                       Opacity="0.4"
                                                       FontSize="15"
                                                       Visibility="{Binding Translation,
                                                           Converter={StaticResource NullToCollapsedConv}}"/>
                                            <TextBlock Text="{Binding Translation}"
                                                       FontSize="15"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       Visibility="{Binding Translation,
                                                           Converter={StaticResource NullToCollapsedConv}}"/>
                                            <!-- Ожидание перевода -->
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="50" Height="3"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0,0,0"
                                                         Visibility="{Binding Translation,
                                                             Converter={StaticResource NullToVisibleConv}}"/>
                                        </WrapPanel>

                                        <!-- Контекстное предложение -->
                                        <TextBlock Text="{Binding ContextSentence}"
                                                   FontStyle="Italic"
                                                   Opacity="0.65"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding ContextSentence,
                                                       Converter={StaticResource NullToCollapsedConv}}"/>

                                        <!-- Медиа-контекст -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0"
                                                    Visibility="{Binding Media.HasMedia,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Command="{Binding DataContext.OpenVideoCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="4,2"
                                                    Height="24"
                                                    FontSize="11">
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="Play"
                                                                 Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,4,0"/>
                                                    <TextBlock>
                                                        <Run Text="{Binding Media.VideoTitle}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Media.TimestampDisplay, Mode=OneWay}"
                                                             />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Статус -->
                                        <Border CornerRadius="3"
                                                Margin="0,4,0,0"
                                                Padding="6,2"
                                                HorizontalAlignment="Left">
                                            <Border.Background>
                                                <Binding Path="Status"
                                                         Converter="{StaticResource StatusToBackgroundConverter}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Кнопки действий -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">

                                        <!-- Избранное -->
                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Toggle favorite">
                                            <md:PackIcon Kind="{Binding IsFavorite,
                                                Converter={StaticResource BoolToStarIconConverter}}"
                                                         Width="18" Height="18"/>
                                        </Button>

                                        <!-- Архив / Восстановить -->
                                        <Button Command="{Binding DataContext.ArchiveCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Archive"
                                                Visibility="{Binding IsArchived,
                                                    Converter={StaticResource InverseBoolToVisConverter}}">
                                            <md:PackIcon Kind="Archive" Width="16" Height="16" Opacity="0.5"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.RestoreCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Restore from archive"
                                                Visibility="{Binding IsArchived,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <md:PackIcon Kind="Restore" Width="16" Height="16"/>
                                        </Button>

                                        <!-- Удалить -->
                                        <Button Command="{Binding DataContext.DeleteCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Delete">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16" Opacity="0.5"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ STATUS BAR ════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{DynamicResource MaterialDesignToolBarBackground}"
                Padding="12,5">
            <Grid>
                <TextBlock HorizontalAlignment="Left"
                           Opacity="0.6"
                           FontSize="12">
                    <Run Text="{Binding ShownCount, Mode=OneWay}"/>
                    <Run Text="shown /"/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="total"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
