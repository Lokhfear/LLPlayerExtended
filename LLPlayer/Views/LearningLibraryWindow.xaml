
<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:LLPlayer.Models"
        xmlns:services="clr-namespace:LLPlayer.Services"
        Title="Learning Library"
        Width="680"
        Height="600"
        MinWidth="500"
        MinHeight="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource LLE.Brush.Background.Primary}"
            BorderBrush="{DynamicResource LLE.Brush.Border.Secondary}"
            BorderThickness="0.5"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>      <!-- Titlebar -->
                <RowDefinition Height="Auto"/>    <!-- Pin hint -->
                <RowDefinition Height="Auto"/>    <!-- Toolbar -->
                <RowDefinition Height="*"/>       <!-- Cards list -->
                <RowDefinition Height="Auto"/>    <!-- Statusbar -->
            </Grid.RowDefinitions>

            <!-- ══ TITLEBAR ═══════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#2D2D2D"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <md:PackIcon Grid.Column="0"
                                 Kind="BookOpenPageVariant"
                                 Width="14"
                                 Height="14"
                                 Margin="10,0,0,0"
                                 Foreground="#AAAAAA"
                                 VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="Learning Library"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>

                    <!-- Count -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalCount, StringFormat={}{0} words}"
                               FontSize="11"
                               Foreground="#777777"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"/>

                    <!-- Pin Button -->
                    <ToggleButton Grid.Column="3"
                                  IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  Width="28"
                                  Height="28"
                                  Margin="0,0,4,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip="Pin to left side">
                        <md:PackIcon Kind="SidebarLeftCollapse"
                                     Width="14"
                                     Height="14"
                                     Foreground="#7c6af7"/>
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#3a3060"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Minimize Button -->
                    <Button Grid.Column="4"
                            Click="MinimizeButton_Click"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Minimize"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <md:PackIcon Kind="Minus"
                                     Width="14"
                                     Height="14"
                                     Foreground="#AAAAAA"/>
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="5"
                            Click="CloseButton_Click"
                            Width="28"
                            Height="28"
                            Margin="0,0,10,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Close"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <md:PackIcon Kind="Close"
                                     Width="14"
                                     Height="14"
                                     Foreground="#AAAAAA"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ PIN HINT ═══════════════════════════════════ -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                    BorderThickness="0,0.5,0,0.5"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="PushPin"
                                 Width="12"
                                 Height="12"
                                 Foreground="#7c6af7"
                                 Margin="0,0,6,0"/>
                    <TextBlock Text="Pinned: hides in fullscreen · shows on pause"
                               FontSize="11"
                               Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                               VerticalAlignment="Center"/>
                    <Border Background="#3a3060"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="10,0,0,0">
                        <TextBlock Text="Pinned"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#a78bfa"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ TOOLBAR (Search + Sort) ═══════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                    BorderThickness="0,0,0,0.5"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint=" Search words..."
                             Style="{StaticResource LLE.FilterTextBox}"
                             VerticalAlignment="Center"
                             Height="28"
                             FontSize="12"/>

                    <!-- Sort ComboBox -->
                    <ComboBox Grid.Column="1"
                              SelectedValue="{Binding SortMode}"
                              SelectedValuePath="Tag"
                              VerticalAlignment="Center"
                              Height="28"
                              Width="120"
                              Margin="8,0,0,0"
                              FontSize="12"
                              Style="{StaticResource LLE.FilterComboBox}">
                        <ComboBoxItem Content="By date ↓" Tag="Newest"/>
                        <ComboBoxItem Content="A — Z" Tag="Alphabetical"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ══ CARDS LIST ═══════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource LLE.Brush.Background.Tertiary}"
                    Padding="6,8">
                <Grid>
                    <!-- Loading Indicator -->
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 VerticalAlignment="Top"
                                 Height="2"/>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisibilityConv}}"
                                Margin="32">
                        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="No words yet"
                                   FontSize="16" FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LLE.Brush.Text.Tertiary}"/>
                        <TextBlock Text="Right-click a word in subtitles → Add to Dictionary"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource LLE.Brush.Text.Hint}"/>
                    </StackPanel>

                    <!-- Cards List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Entries.Count, Converter={StaticResource NullToVisibleConv}}">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Card -->
                                    <Border Margin="0,0,0,5"
                                            Background="{DynamicResource LLE.Brush.Background.Primary}"
                                            BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                                            BorderThickness="0.5"
                                            CornerRadius="6"
                                            MinHeight="52">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource LLE.Brush.Border.Secondary}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Word + Sentence -->
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Margin="12,8">
                                                <TextBlock Text="{Binding Word}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#7c6af7"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sentence}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Divider -->
                                            <Rectangle Grid.Column="1"
                                                       Fill="{DynamicResource LLE.Brush.Border.Tertiary}"
                                                       Width="1"
                                                       Margin="0,8"/>

                                            <!-- Right: Translation + Sentence Translation -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="12,8">
                                                <TextBlock Text="{Binding Translation}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Primary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SentenceTranslation}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding SentenceTranslation, Converter={StaticResource NullToCollapsedConv}}"/>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0">
                                                <!-- Play Button -->
                                                <Button Command="{Binding DataContext.PlayAtTimestampCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="22"
                                                        Height="22"
                                                        Margin="0,0,0,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip="Play at timestamp"
                                                        Visibility="{Binding Timestamp, Converter={StaticResource NullToCollapsedConv}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource LLE.Brush.Text.Secondary}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource LLE.Brush.Background.Secondary}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource LLE.Brush.Text.Primary}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <md:PackIcon Kind="Play" Width="12" Height="12"/>
                                                </Button>

                                                <!-- Delete Button -->
                                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="22"
                                                        Height="22"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip="Delete">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource LLE.Brush.Text.Secondary}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource LLE.Brush.Background.Secondary}"/>
                                                                    <Setter Property="Foreground" Value="#e24b4a"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <md:PackIcon Kind="TrashCanOutline" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ STATUSBAR ═══════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                    BorderThickness="0,0.5,0,0"
                    Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontSize="11"
                               Foreground="{DynamicResource LLE.Brush.Text.Secondary}">
                        <Run Text="Shown: "/>
                        <Run Text="{Binding Entries.Count}"/>
                        <Run Text=" / Total: "/>
                        <Run Text="{Binding TotalCount}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               FontSize="11"
                               Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                               Text="Ctrl+Click on subtitle — add word"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
