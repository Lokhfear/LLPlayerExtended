<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:LLPlayer.Models"
        xmlns:services="clr-namespace:LLPlayer.Services"
        Title="Learning Library"
        Width="950" Height="650"
        MinWidth="600" MinHeight="450"
        Background="#121212"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Tab bar -->
            <RowDefinition Height="Auto"/>  <!-- Filter bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📖 Learning Library"
                           Foreground="#FFFFFF"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ImportCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#90CAF9"
                            Content="Import"
                            Margin="0,0,8,0"/>

                    <Button Command="{Binding ExportCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#90CAF9"
                            Content="Export"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ВКЛАДКИ ════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#181818" Padding="8,4">
            <StackPanel Orientation="Horizontal">

                <RadioButton Content="All"
                             IsChecked="True"
                             Style="{StaticResource MaterialDesignTabRadioButton}"
                             Command="{Binding ClearFiltersCommand}"
                             Margin="4,0"
                             Foreground="#B0B0B0"/>

                <RadioButton Content="⭐ Favorites"
                             Style="{StaticResource MaterialDesignTabRadioButton}"
                             Margin="4,0"
                             Foreground="#B0B0B0">
                    <RadioButton.Command>
                        <Binding Path="FavoritesOnlyCommand"/>
                    </RadioButton.Command>
                </RadioButton>

                <RadioButton Content="🗄 Archive"
                             Style="{StaticResource MaterialDesignTabRadioButton}"
                             Margin="4,0"
                             Foreground="#B0B0B0">
                    <RadioButton.IsChecked>
                        <Binding Path="ShowArchived"/>
                    </RadioButton.IsChecked>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ══ FILTER BAR ════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="🔍 Search text, translation, tags, video..."
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     md:TextFieldAssist.HasClearButton="True"
                     Margin="0,0,8,0"
                     FontSize="13"/>

            <!-- Тип -->
            <ComboBox Grid.Column="1"
                      SelectedValue="{Binding FilterType}"
                      SelectedValuePath="Tag"
                      md:HintAssist.Hint="Type"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      Margin="0,0,8,0"
                      FontSize="13">
                <ComboBoxItem Content="All types" Tag="{x:Null}"/>
                <ComboBoxItem Content="Word"     Tag="{x:Static models:ItemType.Word}"/>
                <ComboBoxItem Content="Phrase"   Tag="{x:Static models:ItemType.Phrase}"/>
                <ComboBoxItem Content="Sentence" Tag="{x:Static models:ItemType.Sentence}"/>
            </ComboBox>

            <!-- Статус -->
            <ComboBox Grid.Column="2"
                      SelectedValue="{Binding FilterStatus}"
                      SelectedValuePath="Tag"
                      md:HintAssist.Hint="Status"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      Margin="0,0,8,0"
                      FontSize="13">
                <ComboBoxItem Content="All statuses" Tag="{x:Null}"/>
                <ComboBoxItem Content="New"      Tag="{x:Static models:LearningStatus.New}"/>
                <ComboBoxItem Content="Learning" Tag="{x:Static models:LearningStatus.Learning}"/>
                <ComboBoxItem Content="Learned"  Tag="{x:Static models:LearningStatus.Learned}"/>
                <ComboBoxItem Content="Ignored"  Tag="{x:Static models:LearningStatus.Ignored}"/>
            </ComboBox>

            <!-- Сортировка -->
            <ComboBox Grid.Column="3"
                      SelectedValue="{Binding SortMode}"
                      SelectedValuePath="Tag"
                      md:HintAssist.Hint="Sort by"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      Margin="0,0,8,0"
                      FontSize="13">
                <ComboBoxItem Content="Newest"    Tag="{x:Static services:SortMode.Newest}"/>
                <ComboBoxItem Content="Oldest"    Tag="{x:Static services:SortMode.Oldest}"/>
                <ComboBoxItem Content="A → Z"     Tag="{x:Static services:SortMode.Alphabetical}"/>
                <ComboBoxItem Content="Reviewed"  Tag="{x:Static services:SortMode.RecentlyReviewed}"/>
            </ComboBox>

            <!-- Сбросить -->
            <Button Grid.Column="4"
                    Command="{Binding ClearFiltersCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Clear all filters"
                    VerticalAlignment="Center"
                    Width="36" Height="36">
                <md:PackIcon Kind="FilterRemove" Width="18" Height="18" Opacity="0.6"/>
            </Button>
        </Grid>

        <!-- ══ СПИСОК ════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">

            <!-- Загрузка -->
            <ProgressBar IsIndeterminate="True"
                         VerticalAlignment="Top"
                         Height="2"
                         Visibility="{Binding IsLoading,
                             Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- ПУСТОЙ ЭКРАН -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="📭" FontSize="48"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Nothing here yet"
                           FontSize="18" FontWeight="Medium"
                           HorizontalAlignment="Center" Opacity="0.7"/>
                <TextBlock Text="Right-click a word in subtitles → Add to Dictionary"
                           FontSize="13" Opacity="0.5"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- СПИСОК КАРТОЧЕК — VirtualizingStackPanel для производительности -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty,
                              Converter={StaticResource InverseBoolToVisConverter}}">
                <ItemsControl ItemsSource="{Binding Items}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Margin="12,4,12,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ── КАРТОЧКА ────────────────────────── -->
                            <md:Card Margin="8,4" Padding="0" UniformCornerRadius="12" Background="#1E1E1E">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Основная часть (всегда видна) -->
                                    <Grid Grid.Row="0" Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- тип-значок -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>  <!-- кнопки -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Тип + статус (скрыто - убран визуал типа) -->
                                        <!-- Border удален - больше не показываем метки W/P/S -->

                                        <!-- Контент -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                            <!-- Слово + перевод -->
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <TextBlock Text=" — "
                                                           Opacity="0.4"
                                                           FontSize="16"
                                                           Visibility="{Binding Translation,
                                                               Converter={StaticResource NullToCollapsedConv}}"/>
                                                <TextBlock Text="{Binding Translation}"
                                                           FontSize="16"
                                                           Foreground="#90CAF9"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding Translation,
                                                               Converter={StaticResource NullToCollapsedConv}}"/>
                                                <!-- Ожидание перевода -->
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="50" Height="3"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0,0,0"
                                                             Visibility="{Binding Translation,
                                                                 Converter={StaticResource NullToVisibleConv}}"/>
                                            </WrapPanel>

                                            <!-- Контекстное предложение (кратко) -->
                                            <TextBlock Text="{Binding ContextSentence}"
                                                       FontStyle="Italic"
                                                       Opacity="0.6"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Foreground="#B0B0B0"
                                                       Visibility="{Binding ContextSentence,
                                                           Converter={StaticResource NullToCollapsedConv}}"/>
                                        </StackPanel>

                                        <!-- Кнопки действий -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Избранное -->
                                            <Button Command="{Binding DataContext.ToggleFavoriteCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="36" Height="36"
                                                    ToolTip="Toggle favorite">
                                                <md:PackIcon Kind="{Binding IsFavorite,
                                                    Converter={StaticResource BoolToStarIconConverter}}"
                                                             Width="18" Height="18"/>
                                            </Button>

                                            <!-- Архив / Восстановить -->
                                            <Button Command="{Binding DataContext.ArchiveCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="36" Height="36"
                                                    ToolTip="Archive"
                                                    Visibility="{Binding IsArchived,
                                                        Converter={StaticResource InverseBoolToVisConverter}}">
                                                <md:PackIcon Kind="Archive" Width="16" Height="16" Opacity="0.5"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.RestoreCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="36" Height="36"
                                                    ToolTip="Restore from archive"
                                                    Visibility="{Binding IsArchived,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <md:PackIcon Kind="Restore" Width="16" Height="16"/>
                                            </Button>

                                            <!-- Удалить -->
                                            <Button Command="{Binding DataContext.DeleteCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="36" Height="36"
                                                    ToolTip="Delete">
                                                <md:PackIcon Kind="Delete" Width="16" Height="16" Opacity="0.5"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Раскрываемая часть (полное предложение + медиа) -->
                                    <Border Grid.Row="1"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="#2A2A2A"
                                            Background="#181818">
                                        <StackPanel Margin="16,12">
                                            <!-- Полное предложение -->
                                            <TextBlock Text="{Binding ContextSentence}"
                                                       FontSize="13"
                                                       Opacity="0.8"
                                                       TextWrapping="Wrap"
                                                       Foreground="#E0E0E0"
                                                       Visibility="{Binding ContextSentence,
                                                           Converter={StaticResource NullToCollapsedConv}}"/>
                                            
                                            <!-- Перевод предложения -->
                                            <TextBlock Text="{Binding ContextSentenceTranslation}"
                                                       FontSize="12"
                                                       Opacity="0.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Foreground="#B0B0B0"
                                                       Visibility="{Binding ContextSentenceTranslation,
                                                           Converter={StaticResource NullToCollapsedConv}}"/>
                                            
                                            <!-- Медиа-контекст с кнопкой воспроизведения -->
                                            <Button Command="{Binding DataContext.OpenVideoCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding Media.HasMedia,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="PlayCircle" Width="18" Height="18" 
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="{Binding Media.VideoTitle}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Media.TimestampDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══ STATUS BAR ════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="#1A1A1A"
                Padding="12,8">
            <Grid>
                <TextBlock HorizontalAlignment="Left"
                           Opacity="0.5"
                           FontSize="11"
                           Foreground="#9E9E9E">
                    <Run Text="{Binding ShownCount, Mode=OneWay}"/>
                    <Run Text="shown / "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="total"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
