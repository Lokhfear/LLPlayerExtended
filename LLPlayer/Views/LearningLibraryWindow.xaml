<Window x:Class="LLPlayer.Views.LearningLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:LLPlayer.Models"
        xmlns:services="clr-namespace:LLPlayer.Services"
        Title="Learning Library"
        Width="680"
        Height="600"
        MinWidth="500"
        MinHeight="400"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Стиль для кнопок управления окном -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="4"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки Close с красным фоном при наведении -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ToggleButton Pin -->
        <Style x:Key="PinToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="4"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#7c6af7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Конвертеры -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Border Background="{DynamicResource LLE.Brush.Background.Primary}"
            BorderBrush="{DynamicResource LLE.Brush.Border.Secondary}"
            BorderThickness="0.5"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>      <!-- Titlebar -->
                <RowDefinition Height="Auto"/>    <!-- Pin hint -->
                <RowDefinition Height="Auto"/>    <!-- Toolbar -->
                <RowDefinition Height="*"/>       <!-- Cards list -->
                <RowDefinition Height="Auto"/>    <!-- Statusbar -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- TITLEBAR -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#2D2D2D"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <md:PackIcon Grid.Column="0"
                                 Kind="BookOpenPageVariant"
                                 Width="16"
                                 Height="16"
                                 Margin="12,0,0,0"
                                 Foreground="#7c6af7"
                                 VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="Learning Library"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <!-- Count -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalCount, StringFormat={}{0} words}"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0"/>

                    <!-- Pin Button -->
                    <ToggleButton Grid.Column="3"
                                  Style="{StaticResource PinToggleButton}"
                                  IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  Margin="4,0,2,0"
                                  ToolTip="Pin to left side (pinned window stays on pause)">
                        <md:PackIcon Kind="DockLeft"
                                     Width="16"
                                     Height="16"
                                     Foreground="#FFFFFF"
                                     Opacity="0.8"/>
                    </ToggleButton>

                    <!-- Minimize Button -->
                    <Button Grid.Column="4"
                            Style="{StaticResource WindowControlButton}"
                            Click="MinimizeButton_Click"
                            Margin="2,0,2,0"
                            ToolTip="Minimize">
                        <md:PackIcon Kind="Minus"
                                     Width="14"
                                     Height="14"
                                     Foreground="#FFFFFF"
                                     Opacity="0.8"/>
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="5"
                            Style="{StaticResource CloseButton}"
                            Click="CloseButton_Click"
                            Margin="2,0,12,0"
                            ToolTip="Close">
                        <md:PackIcon Kind="Close"
                                     Width="14"
                                     Height="14"
                                     Foreground="#FFFFFF"
                                     Opacity="0.9"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- PIN HINT (shows only when pinned) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                    BorderThickness="0,0.5,0,0.5"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="PinOutline"
                                 Width="12"
                                 Height="12"
                                 Foreground="#7c6af7"
                                 Margin="0,0,8,0"/>
                    <TextBlock Text="Pinned window — stays visible on pause/seek, auto-hides in fullscreen"
                               FontSize="11"
                               Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                               VerticalAlignment="Center"/>
                    <Border Background="#7c6af7"
                            CornerRadius="3"
                            Padding="8,3"
                            Margin="12,0,0,0">
                        <TextBlock Text="PINNED"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- TOOLBAR (Search + Sort + Refresh) -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                    BorderThickness="0,0,0,0.5"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="Search words..."
                             Style="{StaticResource LLE.FilterTextBox}"
                             VerticalAlignment="Center"
                             Height="30"
                             FontSize="12"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Width="36"
                            Height="30"
                            Margin="8,0,4,0"
                            ToolTip="Refresh list"
                            Style="{StaticResource LLE.IconButton.Compact}">
                        <md:PackIcon Kind="Refresh" 
                                     Width="16" 
                                     Height="16"
                                     Foreground="{DynamicResource LLE.Brush.Text.Primary}"/>
                    </Button>

                    <!-- Sort ComboBox -->
                    <ComboBox Grid.Column="2"
                              SelectedValue="{Binding SortMode}"
                              SelectedValuePath="Tag"
                              VerticalAlignment="Center"
                              Height="30"
                              Width="130"
                              FontSize="12"
                              Style="{StaticResource LLE.FilterComboBox}">
                        <ComboBoxItem Content="📅 Newest first" Tag="Newest"/>
                        <ComboBoxItem Content="🔤 A — Z" Tag="Alphabetical"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- CARDS LIST -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource LLE.Brush.Background.Tertiary}"
                    Padding="8,10">
                <Grid>
                    <!-- Loading Indicator -->
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 VerticalAlignment="Top"
                                 Height="2"
                                 Foreground="#7c6af7"/>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasNoEntries, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="32">
                        <TextBlock Text="📚" 
                                   FontSize="64" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,20"
                                   Opacity="0.5"/>
                        <TextBlock Text="No words yet"
                                   FontSize="16" 
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LLE.Brush.Text.Tertiary}"/>
                        <TextBlock Text="Right-click a word in subtitles → Add to Dictionary"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource LLE.Brush.Text.Hint}"/>
                    </StackPanel>

                    <!-- Cards List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Background="{DynamicResource LLE.Brush.Background.Primary}"
                                            BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            MinHeight="60">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#7c6af7"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Word + Sentence -->
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Margin="14,10">
                                                <TextBlock Text="{Binding Word}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#7c6af7"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sentence}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="40"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Divider -->
                                            <Rectangle Grid.Column="1"
                                                       Fill="{DynamicResource LLE.Brush.Border.Tertiary}"
                                                       Width="1"
                                                       Margin="0,12"/>

                                            <!-- Right: Translation + Sentence Translation -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="14,10">
                                                <TextBlock Text="{Binding Translation}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Primary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SentenceTranslation}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="40"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding SentenceTranslation, Converter={StaticResource NullToCollapsedConv}}"/>
                                            </StackPanel>

                                           <!-- Actions Buttons -->
<StackPanel Grid.Column="3"
            VerticalAlignment="Center"
            Margin="12,8">
    <!-- Play Button -->
    <Button Command="{Binding DataContext.PlayAtTimestampCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Width="32"
            Height="32"
            Margin="0,0,0,6"
            ToolTip="Play at timestamp"
            Style="{StaticResource LLE.IconButton.Compact}"
            Visibility="{Binding Timestamp, Converter={StaticResource NullToCollapsedConv}}">
        <md:PackIcon Kind="Play" 
                     Width="16" 
                     Height="16"
                     Foreground="#4CAF50"/>
    </Button>

    <!-- Delete Button -->
    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Width="32"
            Height="32"
            ToolTip="Delete"
            Style="{StaticResource LLE.IconButton.Compact}">
        <md:PackIcon Kind="TrashCanOutline" 
                     Width="16" 
                     Height="16"
                     Foreground="#E81123"/>
    </Button>
</StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- STATUSBAR -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource LLE.Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource LLE.Brush.Border.Tertiary}"
                    BorderThickness="0,0.5,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="CardsOutline"
                                     Width="14"
                                     Height="14"
                                     Foreground="#7c6af7"
                                     Margin="0,0,8,0"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource LLE.Brush.Text.Secondary}"
                                   VerticalAlignment="Center">
                            <Run Text="Showing "/>
                            <Run Text="{Binding DisplayedCount}" FontWeight="SemiBold" Foreground="#7c6af7"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalCount}" FontWeight="SemiBold"/>
                            <Run Text=" words"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>