<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ═══════════════════════════════════════ -->
  <!--  COLORS                                 -->
  <!-- ═══════════════════════════════════════ -->

  <!-- Backgrounds (darkest → lightest) -->
  <Color x:Key="BgBase">#0A0A0B</Color>
  <Color x:Key="BgSurface">#141416</Color>
  <Color x:Key="BgElevated">#1C1C1F</Color>
  <Color x:Key="BgOverlay">#242428</Color>
  <Color x:Key="BgHover">#2A2A2F</Color>

  <!-- Borders -->
  <Color x:Key="BorderSubtle">#232327</Color>
  <Color x:Key="BorderDefault">#2E2E35</Color>
  <Color x:Key="BorderStrong">#3D3D47</Color>

  <!-- Primary accent -->
  <Color x:Key="PrimaryDefault">#7C6CFC</Color>
  <Color x:Key="PrimaryHover">#6B5CEF</Color>
  <Color x:Key="PrimaryPressed">#5A4EDD</Color>
  <Color x:Key="PrimaryMuted">#7C6CFC22</Color>
  <Color x:Key="PrimarySubtle">#7C6CFC14</Color>

  <!-- Text -->
  <Color x:Key="TextPrimary">#F2F2F3</Color>
  <Color x:Key="TextSecondary">#8E8E98</Color>
  <Color x:Key="TextTertiary">#5C5C66</Color>
  <Color x:Key="TextDisabled">#3D3D47</Color>
  <Color x:Key="TextOnPrimary">#FFFFFF</Color>

  <!-- Semantic -->
  <Color x:Key="SemanticSuccess">#3ECF8E</Color>
  <Color x:Key="SemanticWarning">#F5A623</Color>
  <Color x:Key="SemanticError">#FF4D4F</Color>
  <Color x:Key="SemanticInfo">#4F9CF9</Color>

  <!-- ═══════════════════════════════════════ -->
  <!--  BRUSHES (from Colors above)            -->
  <!-- ═══════════════════════════════════════ -->

  <SolidColorBrush x:Key="BrBgBase"         Color="{StaticResource BgBase}"/>
  <SolidColorBrush x:Key="BrBgSurface"      Color="{StaticResource BgSurface}"/>
  <SolidColorBrush x:Key="BrBgElevated"     Color="{StaticResource BgElevated}"/>
  <SolidColorBrush x:Key="BrBgOverlay"      Color="{StaticResource BgOverlay}"/>
  <SolidColorBrush x:Key="BrBgHover"        Color="{StaticResource BgHover}"/>

  <SolidColorBrush x:Key="BrBorderSubtle"   Color="{StaticResource BorderSubtle}"/>
  <SolidColorBrush x:Key="BrBorderDefault"  Color="{StaticResource BorderDefault}"/>

  <SolidColorBrush x:Key="BrPrimary"        Color="{StaticResource PrimaryDefault}"/>
  <SolidColorBrush x:Key="BrPrimaryHover"   Color="{StaticResource PrimaryHover}"/>
  <SolidColorBrush x:Key="BrPrimaryMuted"   Color="{StaticResource PrimaryMuted}"/>
  <SolidColorBrush x:Key="BrPrimarySubtle"  Color="{StaticResource PrimarySubtle}"/>

  <SolidColorBrush x:Key="BrTextPrimary"    Color="{StaticResource TextPrimary}"/>
  <SolidColorBrush x:Key="BrTextSecondary"  Color="{StaticResource TextSecondary}"/>
  <SolidColorBrush x:Key="BrTextTertiary"   Color="{StaticResource TextTertiary}"/>
  <SolidColorBrush x:Key="BrTextDisabled"   Color="{StaticResource TextDisabled}"/>

  <SolidColorBrush x:Key="BrSuccess"        Color="{StaticResource SemanticSuccess}"/>
  <SolidColorBrush x:Key="BrWarning"        Color="{StaticResource SemanticWarning}"/>
  <SolidColorBrush x:Key="BrError"          Color="{StaticResource SemanticError}"/>
  <SolidColorBrush x:Key="BrInfo"           Color="{StaticResource SemanticInfo}"/>

  <!-- ═══════════════════════════════════════ -->
  <!--  CORNER RADIUS                          -->
  <!-- ═══════════════════════════════════════ -->
  <CornerRadius x:Key="RadiusXS">4</CornerRadius>
  <CornerRadius x:Key="RadiusSM">6</CornerRadius>
  <CornerRadius x:Key="RadiusMD">8</CornerRadius>
  <CornerRadius x:Key="RadiusLG">12</CornerRadius>
  <CornerRadius x:Key="RadiusXL">16</CornerRadius>
  <CornerRadius x:Key="RadiusFull">999</CornerRadius>

  <!-- ═══════════════════════════════════════ -->
  <!--  SPACING (use as Thickness or Margin)   -->
  <!-- ═══════════════════════════════════════ -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">20</sys:Double>
  <sys:Double x:Key="Space6">24</sys:Double>
  <sys:Double x:Key="Space8">32</sys:Double>
  <sys:Double x:Key="Space10">40</sys:Double>

</ResourceDictionary>
