<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- ════════════════════════════════════════════════════════════════════
         LLPlayerExtended Design Tokens
         Стиль для компонентов словаря и библиотеки обучения
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ─── COLORS ────────────────────────────────────────────────────────── -->
    <!-- Backgrounds -->
    <Color x:Key="LLE.Background.Primary">#121212</Color>
    <Color x:Key="LLE.Background.Secondary">#1E1E1E</Color>
    <Color x:Key="LLE.Background.Tertiary">#181818</Color>
    <Color x:Key="LLE.Background.Quaternary">#1A1A1A</Color>
    
    <!-- Surfaces -->
    <SolidColorBrush x:Key="LLE.Brush.Background.Primary" Color="{StaticResource LLE.Background.Primary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Background.Secondary" Color="{StaticResource LLE.Background.Secondary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Background.Tertiary" Color="{StaticResource LLE.Background.Tertiary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Background.Quaternary" Color="{StaticResource LLE.Background.Quaternary}"/>
    
    <!-- Text Colors (Light Theme Safe) -->
    <Color x:Key="LLE.Text.Primary">#FFFFFF</Color>
    <Color x:Key="LLE.Text.Secondary">#E0E0E0</Color>
    <Color x:Key="LLE.Text.Tertiary">#B0B0B0</Color>
    <Color x:Key="LLE.Text.Hint">#9E9E9E</Color>
    <Color x:Key="LLE.Text.Disabled">#757575</Color>
    
    <SolidColorBrush x:Key="LLE.Brush.Text.Primary" Color="{StaticResource LLE.Text.Primary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Text.Secondary" Color="{StaticResource LLE.Text.Secondary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Text.Tertiary" Color="{StaticResource LLE.Text.Tertiary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Text.Hint" Color="{StaticResource LLE.Text.Hint}"/>
    <SolidColorBrush x:Key="LLE.Brush.Text.Disabled" Color="{StaticResource LLE.Text.Disabled}"/>
    
    <!-- Accent Colors -->
    <Color x:Key="LLE.Accent.Blue">#90CAF9</Color>
    <Color x:Key="LLE.Accent.Green">#81C784</Color>
    <Color x:Key="LLE.Accent.Orange">#FFB74D</Color>
    <Color x:Key="LLE.Accent.Red">#E57373</Color>
    <Color x:Key="LLE.Accent.Purple">#7c6af7</Color>
    
    <SolidColorBrush x:Key="LLE.Brush.Accent.Blue" Color="{StaticResource LLE.Accent.Blue}"/>
    <SolidColorBrush x:Key="LLE.Brush.Accent.Green" Color="{StaticResource LLE.Accent.Green}"/>
    <SolidColorBrush x:Key="LLE.Brush.Accent.Orange" Color="{StaticResource LLE.Accent.Orange}"/>
    <SolidColorBrush x:Key="LLE.Brush.Accent.Red" Color="{StaticResource LLE.Accent.Red}"/>
    <SolidColorBrush x:Key="LLE.Brush.Accent.Purple" Color="{StaticResource LLE.Accent.Purple}"/>
    
    <!-- Border Colors -->
    <Color x:Key="LLE.Border.Light">#2A2A2A</Color>
    <Color x:Key="LLE.Border.Medium">#333333</Color>
    <Color x:Key="LLE.Border.Secondary">#444444</Color>
    <Color x:Key="LLE.Border.Tertiary">#3A3A3A</Color>
    
    <SolidColorBrush x:Key="LLE.Brush.Border.Light" Color="{StaticResource LLE.Border.Light}"/>
    <SolidColorBrush x:Key="LLE.Brush.Border.Medium" Color="{StaticResource LLE.Border.Medium}"/>
    <SolidColorBrush x:Key="LLE.Brush.Border.Secondary" Color="{StaticResource LLE.Border.Secondary}"/>
    <SolidColorBrush x:Key="LLE.Brush.Border.Tertiary" Color="{StaticResource LLE.Border.Tertiary}"/>

    <!-- ─── TYPOGRAPHY ────────────────────────────────────────────────────── -->
    <sys:Double x:Key="LLE.FontSize.XSmall">11</sys:Double>
    <sys:Double x:Key="LLE.FontSize.Small">12</sys:Double>
    <sys:Double x:Key="LLE.FontSize.Medium">13</sys:Double>
    <sys:Double x:Key="LLE.FontSize.Regular">14</sys:Double>
    <sys:Double x:Key="LLE.FontSize.Large">16</sys:Double>
    <sys:Double x:Key="LLE.FontSize.XLarge">18</sys:Double>
    <sys:Double x:Key="LLE.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="LLE.FontSize.Headline">24</sys:Double>
    
    <!-- Font Weights -->
    <FontWeight x:Key="LLE.FontWeight.Regular">Regular</FontWeight>
    <FontWeight x:Key="LLE.FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="LLE.FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="LLE.FontWeight.Bold">Bold</FontWeight>
    
    <!-- ─── SPACING ───────────────────────────────────────────────────────── -->
    <Thickness x:Key="LLE.Padding.XSmall">4</Thickness>
    <Thickness x:Key="LLE.Padding.Small">8</Thickness>
    <Thickness x:Key="LLE.Padding.Medium">12</Thickness>
    <Thickness x:Key="LLE.Padding.Regular">16</Thickness>
    <Thickness x:Key="LLE.Padding.Large">20</Thickness>
    <Thickness x:Key="LLE.Padding.XLarge">24</Thickness>
    
    <!-- ─── CORNER RADIUS ─────────────────────────────────────────────────── -->
    <CornerRadius x:Key="LLE.CornerRadius.Small">4</CornerRadius>
    <CornerRadius x:Key="LLE.CornerRadius.Medium">8</CornerRadius>
    <CornerRadius x:Key="LLE.CornerRadius.Large">12</CornerRadius>
    <CornerRadius x:Key="LLE.CornerRadius.XLarge">16</CornerRadius>
    
    <!-- ─── ELEVATION (for future use) ────────────────────────────────────── -->
    <!-- Currently flat design, but prepared for shadows -->
    
    <!-- ─── COMPONENT STYLES ──────────────────────────────────────────────── -->
    
    <!-- Modern IconButton Style -->
    <Style x:Key="LLE.IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Tertiary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Compact IconButton -->
    <Style x:Key="LLE.IconButton.Compact" TargetType="Button" BasedOn="{StaticResource LLE.IconButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    
    <!-- Card Style for Dictionary/Learning Items -->
    <Style x:Key="LLE.Card" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource LLE.Brush.Background.Secondary}"/>
        <Setter Property="Padding" Value="{StaticResource LLE.Padding.Regular}"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>
    
    <!-- Word Text Style -->
    <Style x:Key="LLE.Text.Word" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Primary}"/>
    </Style>
    
    <!-- Translation Text Style -->
    <Style x:Key="LLE.Text.Translation" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.Regular}"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Accent.Blue}"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    
    <!-- Sentence Text Style -->
    <Style x:Key="LLE.Text.Sentence" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!-- Sentence Translation Style -->
    <Style x:Key="LLE.Text.SentenceTranslation" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.Small}"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Tertiary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    
    <!-- Status Badge Style -->
    <Style x:Key="LLE.StatusBadge" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="{StaticResource LLE.CornerRadius.Small}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <!-- Filter ComboBox Style (Dark Theme Safe) -->
    <Style x:Key="LLE.FilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    
    <!-- Filter TextBox Style (Dark Theme Safe) -->
    <Style x:Key="LLE.FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    
    <!-- Section Header Style -->
    <Style x:Key="LLE.Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.XLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Primary}"/>
    </Style>
    
    <!-- Stat Text Style -->
    <Style x:Key="LLE.Text.Stat" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource LLE.FontSize.XSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource LLE.Brush.Text.Hint}"/>
    </Style>
    
</ResourceDictionary>
