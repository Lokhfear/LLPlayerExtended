<UserControl x:Class="LLPlayer.Controls.LearningItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LLPlayer.Converters">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToBackgroundConverter"/>
        <converters:BoolToStarIconConverter x:Key="BoolToStarIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <!-- Modern Card Layout - Cleaner, lighter, more spacious -->
    <Border x:Name="CardBorder"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerMd}"
            Padding="14,12"
            Margin="0,3">
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Status Badge - Smaller, pill-shaped -->
            <Border Grid.Column="0" 
                    CornerRadius="{StaticResource CornerFull}" 
                    Background="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}" 
                    VerticalAlignment="Top" 
                    Margin="0,2,12,0"
                    ToolTip="{Binding Status}"
                    Padding="8,4"
                    MinWidth="48">
                <TextBlock Text="{Binding TypeLabel}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           CharacterSpacing="25"/>
            </Border>
            
            <!-- Content Stack -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <!-- Main Text + Translation - Cleaner hierarchy -->
                <StackPanel>
                    <TextBlock Text="{Binding Text}" 
                               FontSize="15" 
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    
                    <TextBlock Text="{Binding Translation}" 
                               FontSize="14" 
                               Foreground="{StaticResource PrimaryLightBrush}" 
                               Visibility="{Binding Translation, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Context Sentence - More subtle -->
                <TextBlock Text="{Binding ContextSentence}" 
                           FontStyle="Italic" 
                           Opacity="0.5" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Margin="0,6,0,0" 
                           Visibility="{Binding ContextSentence, Converter={StaticResource BoolToVis}}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                
                <!-- Media Context - Compact inline style -->
                <Button Command="{Binding OpenVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource ModernTextButton}"
                        Padding="0"
                        Height="24"
                        FontSize="11"
                        Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PlayCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"
                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Media.VideoTitle}" 
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" • " 
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Media.TimestampDisplay}" 
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <!-- Tags - Smaller chips -->
                <ItemsControl ItemsSource="{Binding Tags}" 
                              Visibility="{Binding Tags.Count, Converter={StaticResource BoolToVis}}"
                              Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrightBrush}"
                                    CornerRadius="{StaticResource CornerFull}"
                                    Padding="6,3"
                                    Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            
            <!-- Action Buttons - Compact vertical stack -->
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Top" Spacing="2">
                <Button Command="{Binding ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource ModernIconButtonSmall}"
                        ToolTip="Toggle Favorite">
                    <md:PackIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToStarIconConverter}}" 
                                 Width="16" Height="16"
                                 Foreground="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConv}, FallbackValue={StaticResource TextTertiaryBrush}}"/>
                </Button>
                
                <Button Command="{Binding ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource ModernIconButtonSmall}"
                        ToolTip="Archive"
                        Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <md:PackIcon Kind="ArchiveOutline" Width="15" Height="15" Opacity="0.6"/>
                </Button>
                
                <Button Command="{Binding RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource ModernIconButtonSmall}"
                        ToolTip="Restore"
                        Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                    <md:PackIcon Kind="Restore" Width="15" Height="15"/>
                </Button>
                
                <Button Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource ModernIconButtonSmall}"
                        ToolTip="Edit">
                    <md:PackIcon Kind="PencilOutline" Width="15" Height="15" Opacity="0.6"/>
                </Button>
                
                <Button Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource ModernIconButtonSmall}"
                        ToolTip="Delete">
                    <md:PackIcon Kind="DeleteOutline" Width="15" Height="15" Opacity="0.6"/>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Hover effect overlay -->
        <Border.Background>
            <SolidColorBrush Color="{StaticResource SurfaceColor}"/>
        </Border.Background>
        
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Cursor" Value="Arrow"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{StaticResource SurfaceLightColor}"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>