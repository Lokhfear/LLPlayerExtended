<UserControl x:Class="LLPlayer.Controls.LearningItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LLPlayer.Converters">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToBackgroundConverter"/>
        <converters:BoolToStarIconConverter x:Key="BoolToStarIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Expand/Collapse Animation -->
        <Storyboard x:Key="ExpandStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Height" 
                           To="Auto" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>
    
    <!-- Modern Expandable Card Layout -->
    <Border x:Name="CardBorder"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerLg}"
            Padding="0"
            Margin="0,4"
            Cursor="Hand">
        
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Cursor" Value="Arrow"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" x:Name="DetailsRow"/>
            </Grid.RowDefinitions>
            
            <!-- Main Content (Always Visible) -->
            <Grid Grid.Row="0" Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Word & Translation -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Type Badge + Word on same line -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border CornerRadius="{StaticResource CornerFull}" 
                                Background="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}" 
                                Padding="6,3"
                                Margin="0,0,8,0"
                                ToolTip="{Binding Status}">
                            <TextBlock Text="{Binding TypeLabel}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontSize="9" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       CharacterSpacing="50"/>
                        </Border>
                        
                        <!-- Main Word - Prominent -->
                        <TextBlock Text="{Binding Text}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   LineHeight="24"/>
                    </StackPanel>
                    
                    <!-- Translation - Secondary emphasis -->
                    <TextBlock Text="{Binding Translation}" 
                               FontSize="15" 
                               FontWeight="Medium"
                               Foreground="{StaticResource PrimaryLightBrush}" 
                               Visibility="{Binding Translation, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap"
                               Margin="0,1,0,0"
                               LineHeight="20"/>
                    
                    <!-- Tags - Compact chips -->
                    <ItemsControl ItemsSource="{Binding Tags}" 
                                  Visibility="{Binding Tags.Count, Converter={StaticResource BoolToVis}}"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrightBrush}"
                                        CornerRadius="{StaticResource CornerFull}"
                                        Padding="5,2"
                                        Margin="0,0,4,0">
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                
                <!-- Action Buttons - Right side -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="4">
                    <!-- Expand/Collapse Toggle -->
                    <Button x:Name="ExpandToggleBtn"
                            Click="ExpandToggleBtn_Click"
                            Style="{StaticResource ModernIconButtonSmall}"
                            ToolTip="Show details">
                        <md:PackIcon x:Name="ExpandIcon" Kind="ChevronDown" Width="18" Height="18"/>
                    </Button>
                    
                    <!-- Favorite -->
                    <Button Command="{Binding ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" 
                            Style="{StaticResource ModernIconButtonSmall}"
                            ToolTip="Toggle Favorite">
                        <md:PackIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToStarIconConverter}}" 
                                     Width="16" Height="16"
                                     Foreground="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConv}, FallbackValue={StaticResource TextTertiaryBrush}}"/>
                    </Button>
                    
                    <!-- Archive/Restore -->
                    <Button Command="{Binding ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" 
                            Style="{StaticResource ModernIconButtonSmall}"
                            ToolTip="Archive"
                            Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <md:PackIcon Kind="ArchiveOutline" Width="15" Height="15" Opacity="0.6"/>
                    </Button>
                    
                    <Button Command="{Binding RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" 
                            Style="{StaticResource ModernIconButtonSmall}"
                            ToolTip="Restore"
                            Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                        <md:PackIcon Kind="Restore" Width="15" Height="15"/>
                    </Button>
                    
                    <!-- More Actions Menu -->
                    <Button x:Name="MoreActionsBtn"
                            Style="{StaticResource ModernIconButtonSmall}"
                            ToolTip="More actions"
                            Click="MoreActionsBtn_Click">
                        <md:PackIcon Kind="DotsVertical" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Expanded Details Section -->
            <Border Grid.Row="1" 
                    x:Name="DetailsBorder"
                    Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrightBrush}"
                    CornerRadius="0,0,{StaticResource CornerLg},{StaticResource CornerLg}"
                    Padding="16,0,16,14"
                    Margin="16,0,16,0">
                <StackPanel>
                    <!-- Divider -->
                    <Separator Style="{StaticResource ModernDivider}" Margin="0,0,0,10"/>
                    
                    <!-- Context Sentence -->
                    <StackPanel Visibility="{Binding ContextSentence, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,12">
                        <TextBlock Text="Context:" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   CharacterSpacing="50"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ContextSentence}" 
                                   FontStyle="Italic" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   LineHeight="18"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ContextSentenceTranslation}" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Visibility="{Binding ContextSentenceTranslation, Converter={StaticResource BoolToVis}}"
                                   LineHeight="16"/>
                    </StackPanel>
                    
                    <!-- Media Section -->
                    <StackPanel Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Source:" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   CharacterSpacing="50"
                                   Margin="0,0,0,6"/>
                        
                        <!-- Video Button with Info -->
                        <Button Command="{Binding OpenVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}" 
                                Style="{StaticResource ModernOutlinedButton}"
                                Padding="12,8"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource PrimaryBrush}" 
                                        CornerRadius="{StaticResource CornerSm}"
                                        Width="28" Height="28"
                                        Margin="0,0,10,0">
                                    <md:PackIcon Kind="Play" Width="14" Height="14" 
                                                 VerticalAlignment="Center" 
                                                 HorizontalAlignment="Center"
                                                 Foreground="White"
                                                 Margin="0,0,0,1"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Media.VideoTitle}" 
                                               FontWeight="Medium"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="300"/>
                                    <TextBlock FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="⏱️"/><Run Text="{Binding Media.TimestampDisplay}"/>
                                        <Run Text="  •  "/>
                                        <Run Text="{Binding Media.ContextType}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Additional Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="8">
                        <Button Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}" 
                                Style="{StaticResource ModernTextButton}"
                                FontSize="11"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Edit"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}" 
                                Style="{StaticResource ModernTextButton}"
                                FontSize="11"
                                Padding="8,4"
                                Foreground="{StaticResource ErrorBrush}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>