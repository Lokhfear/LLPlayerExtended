<UserControl x:Class="LLPlayer.Controls.LearningItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:LLPlayer.Converters">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToBackgroundConverter"/>
        <converters:BoolToStarIconConverter x:Key="BoolToStarIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <md:Card Margin="0,0,0,6" Padding="0" UniformCornerRadius="8">
        <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Type Badge -->
            <Border Grid.Column="0" 
                    Width="32" Height="32" 
                    CornerRadius="6" 
                    Background="{Binding Status, Converter={StaticResource StatusToBackgroundConverter}}" 
                    VerticalAlignment="Top" 
                    Margin="0,0,12,0"
                    ToolTip="{Binding Status}">
                <TextBlock Text="{Binding TypeLabel}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="White"/>
            </Border>
            
            <!-- Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <!-- Main Text + Translation -->
                <WrapPanel>
                    <TextBlock Text="{Binding Text}" 
                               FontSize="15" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text=" — " 
                               Opacity="0.4" 
                               FontSize="15" 
                               Visibility="{Binding Translation, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Translation}" 
                               FontSize="15" 
                               Foreground="{DynamicResource PrimaryHueMidBrush}" 
                               Visibility="{Binding Translation, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap"/>
                </WrapPanel>
                
                <!-- Context Sentence -->
                <TextBlock Text="{Binding ContextSentence}" 
                           FontStyle="Italic" 
                           Opacity="0.65" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Margin="0,4,0,0" 
                           Visibility="{Binding ContextSentence, Converter={StaticResource BoolToVis}}"/>
                
                <!-- Context Translation -->
                <TextBlock Text="{Binding ContextSentenceTranslation}" 
                           FontStyle="Italic" 
                           Opacity="0.5" 
                           FontSize="12" 
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           TextWrapping="Wrap" 
                           Margin="0,2,0,0" 
                           Visibility="{Binding ContextSentenceTranslation, Converter={StaticResource BoolToVis}}"/>
                
                <!-- Media Context -->
                <StackPanel Orientation="Horizontal" 
                            Margin="0,6,0,0" 
                            Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding OpenVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                            CommandParameter="{Binding}" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Padding="6,4" 
                            Height="28" 
                            FontSize="11"
                            ToolTip="Open video at timestamp">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="PlayCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Media.VideoTitle}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Media.TimestampDisplay}" Opacity="0.7" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                
                <!-- Tags -->
                <ItemsControl ItemsSource="{Binding Tags}" 
                              Visibility="{Binding Tags.Count, Converter={StaticResource BoolToVis}}"
                              Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <md:Chip Text="{Binding}" 
                                     Margin="0,0,4,4" 
                                     FontSize="10" 
                                     Height="22"
                                     IsDeletable="False"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Command="{Binding ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource MaterialDesignIconButton}" 
                        ToolTip="Toggle Favorite"
                        Width="36" Height="36">
                    <md:PackIcon Kind="{Binding IsFavorite, Converter={StaticResource BoolToStarIconConverter}}" 
                                 Width="18" Height="18"/>
                </Button>
                
                <Button Command="{Binding ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource MaterialDesignIconButton}" 
                        ToolTip="Archive" 
                        Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        Width="36" Height="36">
                    <md:PackIcon Kind="Archive" Width="16" Height="16" Opacity="0.5"/>
                </Button>
                
                <Button Command="{Binding RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource MaterialDesignIconButton}" 
                        ToolTip="Restore" 
                        Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}"
                        Width="36" Height="36">
                    <md:PackIcon Kind="Restore" Width="16" Height="16"/>
                </Button>
                
                <Button Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource MaterialDesignIconButton}" 
                        ToolTip="Edit"
                        Width="36" Height="36">
                    <md:PackIcon Kind="Pencil" Width="16" Height="16" Opacity="0.5"/>
                </Button>
                
                <Button Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                        CommandParameter="{Binding}" 
                        Style="{StaticResource MaterialDesignIconButton}" 
                        ToolTip="Delete"
                        Width="36" Height="36">
                    <md:PackIcon Kind="Delete" Width="16" Height="16" Opacity="0.5"/>
                </Button>
            </StackPanel>
        </Grid>
    </md:Card>
</UserControl>
