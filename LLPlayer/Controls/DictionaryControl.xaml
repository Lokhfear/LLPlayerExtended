<UserControl x:Class="LLPlayer.Controls.DictionaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:converters="clr-namespace:LLPlayer.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DictionaryViewModel}"
             d:Foreground="White"
             d:Background="#121212"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            
            <!-- null → Collapsed, иначе → Visible -->
            <converters:NullToVisibilityConverter x:Key="NullToCollapsedConv" NullValue="Collapsed"/>
            <!-- null → Visible, иначе → Collapsed -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibleConv" NullValue="Visible"/>
            <!-- 0 → Visible, иначе → Collapsed -->
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConv"/>
            <converters:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
            
            <!-- Modern IconButton Style -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- заголовок + поиск + действия -->
            <RowDefinition Height="Auto"/>  <!-- статистика -->
            <RowDefinition Height="*"/>     <!-- список -->
        </Grid.RowDefinitions>

        <!-- ── Шапка ──────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search words..."
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Margin="0,0,8,0"/>

            <!-- Обновить -->
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="Refresh"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
            </Button>
            
            <!-- Expand All -->
            <Button Grid.Column="2"
                    Command="{Binding ExpandAllCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="Expand All"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ArrowExpandAll" Width="20" Height="20"/>
            </Button>
        </Grid>

        <!-- ── Статистика ────────────────────────────────── -->
        <Border Grid.Row="1" Margin="16,0,16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Opacity="0.6">
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="words total · "/>
                    <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
                    <Run Text="shown"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── Список ────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <!-- Индикатор загрузки -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Top"
                         Height="2"/>

            <!-- Пусто -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisibilityConv}}"
                        Margin="32">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="No words yet"
                           FontSize="16" FontWeight="Medium"
                           HorizontalAlignment="Center" Opacity="0.7"/>
                <TextBlock Text="Right-click a word in subtitles → Add to Dictionary"
                           FontSize="12" Opacity="0.5"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Список слов -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ── КАРТОЧКА СЛОВА ────────────────────────── -->
                            <materialDesign:Card Margin="8,4" Padding="0" 
                                                 UniformCornerRadius="12"
                                                 Background="#1E1E1E">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Основная часть (всегда видна) -->
                                    <Grid Grid.Row="0" Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Слово и перевод -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Word}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="—"
                                                           FontSize="14"
                                                           Opacity="0.4"
                                                           Visibility="{Binding Translation, Converter={StaticResource NullToCollapsedConv}}"/>
                                                <TextBlock Text="{Binding Translation}"
                                                           FontSize="14"
                                                           Foreground="#90CAF9"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding Translation, Converter={StaticResource NullToCollapsedConv}}"/>
                                                <!-- Ожидание перевода -->
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="40" Height="3"
                                                             VerticalAlignment="Center"
                                                             Margin="8,0,0,0"
                                                             Visibility="{Binding Translation, Converter={StaticResource NullToVisibleConv}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Кнопки действий -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Expand/Collapse -->
                                            <Button Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="Toggle details">
                                                <materialDesign:PackIcon Kind="{Binding IsExpanded, Converter={StaticResource BoolToArrowIconConverter}}"
                                                                         Width="18" Height="18" Opacity="0.7"/>
                                            </Button>
                                            
                                            <!-- Delete -->
                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="Delete">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Opacity="0.6"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Раскрываемая часть (предложение + контекст) -->
                                    <Border Grid.Row="1"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                            BorderThickness="0,1,0,0"
                                            BorderBrush="#2A2A2A"
                                            Background="#181818">
                                        <StackPanel Margin="16,12">
                                            <!-- Предложение -->
                                            <TextBlock Text="{Binding Sentence}"
                                                       FontSize="13"
                                                       FontStyle="Italic"
                                                       Opacity="0.8"
                                                       TextWrapping="Wrap"
                                                       Foreground="#E0E0E0"/>
                                            
                                            <!-- Перевод предложения -->
                                            <TextBlock Text="{Binding SentenceTranslation}"
                                                       FontSize="12"
                                                       Opacity="0.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Foreground="#B0B0B0"
                                                       Visibility="{Binding SentenceTranslation, Converter={StaticResource NullToCollapsedConv}}"/>
                                            
                                            <!-- Кнопка воспроизведения -->
                                            <Button Command="{Binding DataContext.PlayAtTimestampCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding Timestamp, Converter={StaticResource NullToCollapsedConv}}"
                                                    Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Play at timestamp" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
