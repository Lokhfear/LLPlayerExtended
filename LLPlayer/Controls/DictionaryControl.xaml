<UserControl x:Class="LLPlayer.Controls.DictionaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             xmlns:converters="clr-namespace:LLPlayer.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DictionaryViewModel}"
             d:Foreground="White"
             d:Background="{StaticResource LLE.Brush.Background.Primary}"
             d:DesignHeight="450" d:DesignWidth="680">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            
            <!-- null → Collapsed, иначе → Visible -->
            <converters:NullToVisibilityConverter x:Key="NullToCollapsedConv" NullValue="Collapsed"/>
            <!-- null → Visible, иначе → Collapsed -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibleConv" NullValue="Visible"/>
            <!-- 0 → Visible, иначе → Collapsed -->
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConv"/>
            <converters:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
            <converters:NullOrEmptyToHiddenConverter x:Key="NullOrEmptyToHiddenConv"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource LLE.Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- Titlebar -->
            <RowDefinition Height="Auto"/>      <!-- Toolbar (search + sort) -->
            <RowDefinition Height="*"/>         <!-- Список карточек -->
            <RowDefinition Height="Auto"/>      <!-- Statusbar -->
        </Grid.RowDefinitions>

        <!-- ── Titlebar ──────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#2D2D2D" Height="36">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <materialDesign:PackIcon Grid.Column="0" Kind="BookOpen" Width="16" Height="16" 
                                         Foreground="#AAAAAA" VerticalAlignment="Center"/>

                <!-- Title -->
                <TextBlock Grid.Column="1" Text="Learning Library" FontSize="12" 
                           Foreground="#CCCCCC" VerticalAlignment="Center" Margin="8,0"/>

                <!-- Count -->
                <TextBlock Grid.Column="2" FontSize="11" Foreground="#777777" 
                           VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="words"/>
                </TextBlock>

                <!-- Pin button -->
                <Button Grid.Column="3" Width="28" Height="28" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="Pin to left"
                        Click="PinButton_Click">
                    <materialDesign:PackIcon Kind="SidebarLeftCollapse" Width="16" Height="16" 
                                             Foreground="#A78BFA"/>
                </Button>

                <!-- Minimize button -->
                <Button Grid.Column="4" Width="28" Height="28" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="Minimize">
                    <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" 
                                             Foreground="#AAAAAA"/>
                </Button>

                <!-- Close button -->
                <Button Grid.Column="5" Width="28" Height="28" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="Close"
                        Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" 
                                             Foreground="#AAAAAA"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Toolbar (Search + Sort) ────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource LLE.Brush.Background.Secondary}" 
                Padding="10,8" BorderBrush="{StaticResource LLE.Brush.Border.Tertiary}" BorderThickness="0,0,0,0.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="&#xf002; Search words..."
                         Style="{StaticResource LLE.FilterTextBox}"
                         Height="28" FontSize="12"
                         VerticalAlignment="Center"/>

                <!-- Sort Dropdown -->
                <ComboBox Grid.Column="1" Width="100" Height="28" FontSize="12"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="By Date ↓"/>
                    <ComboBoxItem Content="A — Z"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ── Cards List ────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource LLE.Brush.Background.Tertiary}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Container -->
                            <Border Margin="6,3" Padding="0" 
                                    CornerRadius="8"
                                    Background="{StaticResource LLE.Brush.Background.Primary}"
                                    BorderBrush="{StaticResource LLE.Brush.Border.Tertiary}"
                                    BorderThickness="0.5"
                                    MinHeight="52">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Sentence (English) -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,8">
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#7C6AF7"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Sentence}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource LLE.Brush.Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Background="{StaticResource LLE.Brush.Border.Tertiary}"/>

                                    <!-- Right: Translation (Russian) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,8">
                                        <TextBlock Text="{Binding Translation}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource LLE.Brush.Text.Primary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SentenceTranslation}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource LLE.Brush.Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding SentenceTranslation, Converter={StaticResource NullToCollapsedConv}}"/>
                                    </StackPanel>

                                    <!-- Actions Panel -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0">
                                        <!-- Play button -->
                                        <Button Command="{Binding DataContext.PlayAtTimestampCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="22" Height="22"
                                                ToolTip="Play at timestamp"
                                                Visibility="{Binding Timestamp, Converter={StaticResource NullToCollapsedConv}}">
                                            <materialDesign:PackIcon Kind="Play" Width="12" Height="12" 
                                                                     Foreground="{StaticResource LLE.Brush.Text.Secondary}"/>
                                        </Button>
                                        <!-- Delete button -->
                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="22" Height="22"
                                                ToolTip="Delete">
                                            <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" 
                                                                     Foreground="{StaticResource LLE.Brush.Text.Secondary}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Statusbar ──────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource LLE.Brush.Background.Secondary}" 
                Padding="12,5" BorderBrush="{StaticResource LLE.Brush.Border.Tertiary}" BorderThickness="0,0.5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Count info -->
                <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource LLE.Brush.Text.Secondary}">
                    <Run Text="Shown: "/>
                    <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
                    <Run Text=" / Total: "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                </TextBlock>

                <!-- Hint -->
                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource LLE.Brush.Text.Secondary}">
                    Ctrl+Click on subtitle to add word
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
