<UserControl x:Class="LLPlayer.Controls.DictionaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LLPlayer.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DictionaryViewModel}"
             d:Foreground="White"
             d:Background="#1E1E1E"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- заголовок + поиск -->
            <RowDefinition Height="Auto"/>  <!-- статистика -->
            <RowDefinition Height="*"/>     <!-- список -->
        </Grid.RowDefinitions>

        <!-- ── Шапка ──────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search words..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

            <!-- Обновить -->
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Refresh"
                    VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
            </Button>
        </Grid>

        <!-- ── Статистика ────────────────────────────────── -->
        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   Opacity="0.6"
                   FontSize="12">
            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
            <Run Text="words total ·"/>
            <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
            <Run Text="shown"/>
        </TextBlock>

        <!-- ── Список ────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <!-- Индикатор загрузки -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         VerticalAlignment="Top"
                         Height="3"/>

            <!-- Пусто -->
            <TextBlock Text="No words yet. Right-click a word in subtitles → Add to Dictionary."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="32"
                       Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisibilityConv}}"/>

            <!-- Список слов -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Слово + перевод -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text=" — "
                                                   FontSize="16"
                                                   Opacity="0.5"
                                                   Visibility="{Binding Translation, Converter={StaticResource NullToCollapsedConv}}"/>
                                        <TextBlock Text="{Binding Translation}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                   Visibility="{Binding Translation, Converter={StaticResource NullToCollapsedConv}}"/>
                                        <!-- Ожидание перевода -->
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="60" Height="4"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,0,0"
                                                     Visibility="{Binding Translation, Converter={StaticResource NullToVisibleConv}}"/>
                                    </StackPanel>

                                    <!-- Предложение -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Sentence}"
                                               FontStyle="Italic"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                    <!-- Перевод предложения -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{Binding SentenceTranslation}"
                                               Opacity="0.5"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding SentenceTranslation, Converter={StaticResource NullToCollapsedConv}}"/>

                                    <!-- Кнопка удаления -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Grid.RowSpan="3"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Delete"
                                            VerticalAlignment="Top">
                                        <materialDesign:PackIcon Kind="Delete"
                                                                 Width="18" Height="18"
                                                                 Opacity="0.6"/>
                                    </Button>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
